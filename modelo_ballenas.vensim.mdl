{UTF-8}
Poblacion ballenas = INTEG( Nacimientos - Muertes totales , 120000 )
~
ballenas
~
|

Nacimientos = Nacimientos netos
~
ballenas/year
~
|

Muertes totales = Muertes naturales + Muertes pesca + Muertes evento 2010
~
ballenas/year
~
|

Nacimientos netos = Poblacion ballenas * Tasa natalidad base * Multiplicador natalidad densidad
~
ballenas/year
~
|

Muertes naturales = Poblacion ballenas * Tasa mortalidad natural base * Multiplicador mortalidad densidad
~
ballenas/year
~
|

Muertes pesca = Poblacion ballenas * Tasa mortalidad pesca * Efectividad tecnologia pesca
~
ballenas/year
~
|

Muertes evento 2010 = Poblacion ballenas * Evento 2010
~
ballenas/year
~
|

Tasa natalidad base = 0.06
~
1/year
~
|

Tasa mortalidad natural base = 0.04
~
1/year
~
|

Tasa mortalidad pesca = 0.015
~
1/year
~
|

Efectividad tecnologia pesca = 1
~
dmnl
~
|

Umbral subpoblacion = 80000
~
ballenas
~
|

Umbral superpoblacion = 180000
~
ballenas
~
|

Densidad relativa = (Poblacion ballenas - Umbral subpoblacion) / (Umbral superpoblacion - Umbral subpoblacion)
~
dmnl
~
|

Multiplicador natalidad densidad = WITH LOOKUP(
  Densidad relativa,
  ([(0,0)-(1.25,1.6)],(0,0.6),(0.25,0.9),(0.5,1),(0.75,0.9),(1,0.7),(1.25,0.5))
)
~
dmnl
~
|

Multiplicador mortalidad densidad = WITH LOOKUP(
  Densidad relativa,
  ([(0,0)-(1.25,1.6)],(0,1.4),(0.25,1.2),(0.5,1),(0.75,1.1),(1,1.3),(1.25,1.6))
)
~
dmnl
~
|

Evento 2010 = STEP(0.08, 2010)
~
1/year
~
|

********************************************************
  .Control
********************************************************~
    Simulation Control Parameters
    |

FINAL TIME  = 2025
	~
	Year
	~
	| The final time for the simulation.

INITIAL TIME  = 1850
	~
	Year
	~
	| The initial time for the simulation.

SAVEPER  = 
        TIME STEP
	~
	Year [0,?]
	~
	| The frequency with which output is stored.

TIME STEP  = 1
	~
	Year [0,?]
	~
	| The time step for the simulation.
