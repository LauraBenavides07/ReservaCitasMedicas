# ──────────────────────────────────────────────
# Piedrazul — Variables de entorno para Railway
# Copia esto en Railway Dashboard > Variables
# ──────────────────────────────────────────────

# ─── Backend ───────────────────────────────────
# Railway provee DB_HOST, DB_PORT, DB_USER, DB_PASSWORD automáticamente
# cuando agregas el plugin PostgreSQL. Se usa la convención de Railway.
# Si usas nombres distintos, ajusta:
DB_HOST=${{Postgres.RAILWAY_TCP_PROXY_DOMAIN}}
DB_PORT=${{Postgres.RAILWAY_TCP_PROXY_PORT}}
DB_USERNAME=${{Postgres.POSTGRES_USER}}
DB_PASSWORD=${{Postgres.POSTGRES_PASSWORD}}
DB_DATABASE=${{Postgres.POSTGRES_DB}}

# JWT
JWT_SECRET=PIEDRAZUL_SECRET_KEY

# RabbitMQ (usar CloudAMQP externo o Railway service)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Keycloak
KEYCLOAK_URL=
KEYCLOAK_REALM=piedrazul
KEYCLOAK_CLIENT_ID=piedrazul-app

# ─── Frontend ──────────────────────────────────
# URL del backend para el proxy nginx (Railway private network)
# Se usa en docker-entrypoint.sh con envsubst
BACKEND_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:3000
