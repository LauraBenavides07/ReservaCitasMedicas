# Copiar a .env en el servidor: cp .env.oracle.example .env
# Generar contraseñas fuertes antes de producción.

# IP pública o dominio (sin http://) — usado por Keycloak
DEPLOY_HOST=TU_IP_PUBLICA

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_password_seguro

# RabbitMQ
RABBITMQ_USER=piedrazul
RABBITMQ_PASS=cambiar_rabbitmq_password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_admin_password
KC_DB_PASSWORD=cambiar_db_password
