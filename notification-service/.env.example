# ─── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_URL=amqp://piedrazul:piedrazul_pass@localhost:5672

# ─── WhatsApp Cloud API (Meta) ─────────────────────────────────
# Obtén estos valores en: https://developers.facebook.com/apps/<tu-app>/whatsapp/
# Para desarrollo usa el número de prueba que Meta provee en el Sandbox.
WHATSAPP_PHONE_NUMBER_ID=REEMPLAZA_CON_TU_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=REEMPLAZA_CON_TU_TOKEN_DE_ACCESO
